{
  "name": "app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "predev": "node scripts/sync-data.mjs",
    "dev": "vite dev",
    "prebuild": "node scripts/sync-data.mjs",
    "build": "vite build",
    "build:e2e": "DATA_SRC=../e2e/fixtures/data node scripts/sync-data.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
